# ---------------------------------------------------------
# ALLOW VIDEO STREAMING ON LIVE SERVER
# ---------------------------------------------------------
AddType video/mp4 .mp4
AddType video/webm .webm

# ---------------------------------------------------------
# ENABLE GZIP COMPRESSION FOR FASTER CORE WEB VITALS
# ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------
# BROWSER CACHING FOR STATIC ASSETS (LCP / SPEED BOOST)
# ---------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---------------------------------------------------------
  # 1. SEO 301 REDIRECTS (Case-Insensitive)
  # ---------------------------------------------------------
  RewriteRule ^Bus-Rental-for-Tour-Packages-in-Pune/?$ /maharashtra-tour-vehicle-rental [R=301,L,NC]
  RewriteRule ^Luxury-Bus-Rental-in-Pune/?$ /bus-rental-pune [R=301,L,NC]
  
  # Redirect 20-seater variations to the correct React route
  RewriteRule ^20-seater-on-rent-in-pune/?$ /20-seater-bus-rental-pune [R=301,L,NC]
  RewriteRule ^20-seater-on-rent-pune/?$ /20-seater-bus-rental-pune [R=301,L,NC]

  # ---------------------------------------------------------
  # 2. PRE-RENDERED STATIC ROUTE HTML + REACT ROUTER CATCH-ALL
  # ---------------------------------------------------------
  DirectoryIndex index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /index.html [QSA,L]
</IfModule>